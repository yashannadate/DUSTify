{
  "name": "dustify-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "contracts",
    "relayer-api",
    "client-sdk",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --prefix client-sdk && npm run build --prefix frontend",
    "build:contracts": "node contracts/scripts/build_all.js",
    "build:sdk": "wsl bash -c \"cd /mnt/d/DUSTify/client-sdk && npm run build\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:relayer": "wsl bash -c \"cd /mnt/d/DUSTify/relayer-api && npx tsx src/index.ts\"",
    "dev:relayer:linux": "npm run dev --prefix relayer-api",
    "test": "npm run test:contracts && npm run test:unit",
    "test:contracts": "npm run test --prefix contracts",
    "test:unit": "wsl bash -c \"cd /mnt/d/DUSTify && npx tsx client-sdk/test/sdk-serialization.test.ts\"",
    "test:relayer": "wsl bash -c \"cd /mnt/d/DUSTify && npx tsx relayer-api/test/test-relayer-endpoints.ts\"",
    "test:sdk": "wsl bash -c \"cd /mnt/d/DUSTify && npx tsx client-sdk/test/test-sdk-client.ts\"",
    "test:sponsorship": "wsl bash -c \"cd /mnt/d/DUSTify && npx tsx relayer-api/test/sponsorship-experiment.ts\"",
    "deploy": "wsl bash -c \"cd /mnt/d/DUSTify && npx tsx scripts/deploy_contract.ts\""
  },
  "keywords": [
    "midnight",
    "dust",
    "relayer",
    "fee-abstraction",
    "zero-knowledge"
  ],
  "author": "Yash Annadate",
  "license": "MIT",
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.15.0"
  }
}

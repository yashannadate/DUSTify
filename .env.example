# DUSTify Environment Configuration
# Copy this file to .env and fill in values.
# NEVER commit .env or real seeds/keys to git.

# ── Midnight Network ──────────────────────────────────────────────────────
MIDNIGHT_NETWORK=preview

# ── Midnight Preview Endpoints (defaults — change for preprod/mainnet) ────
INDEXER_HTTP_URL=https://indexer.preview.midnight.network/api/v4/graphql
INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
NODE_RPC_URL=wss://rpc.preview.midnight.network
PROOF_SERVER_URL=http://127.0.0.1:6300

# ── Relayer Sponsor Wallet ─────────────────────────────────────────────────
# DANGER: Never commit real seeds.
# Generate a new hex seed with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_WALLET_SEED=replace_with_real_64_char_hex_seed

# ── Relayer API ────────────────────────────────────────────────────────────
PORT=3001
DUSTIFY_API_KEY=replace_with_secure_api_key
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_MAX=100

# ── Sync Configuration ─────────────────────────────────────────────────────
# Wallet sync timeout in milliseconds (default 90s for Preview)
SYNC_TIMEOUT_MS=90000
